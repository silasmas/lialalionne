APP_NAME=Lialalionne
APP_ENV=local
APP_KEY=
# En production : APP_ENV=production et APP_DEBUG=false (sinon les erreurs
# affichent la stack trace complète + les variables d'environnement).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lialalionne
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En production (HTTPS obligatoire) : SESSION_SECURE_COOKIE=true, sinon le
# cookie de session peut être intercepté en clair (le paiement en dépend).
SESSION_SECURE_COOKIE=false

# Recherche boutique (Laravel Scout) — moteur "database" : full-text MySQL,
# aucun service externe requis.
SCOUT_DRIVER=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# URL publique des uploads (servie par /media, sans symlink)
# FILESYSTEM_PUBLIC_URL="${APP_URL}/media"
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

FLEXPAY_MARCHAND=
FLEXPAY_API_TOKEN=
FLEXPAY_GATEWAY_MOBILE=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEXPAY_GATEWAY_CARD=https://cardpayment.flexpay.cd/v1.1/pay
FLEXPAY_GATEWAY_CHECK=https://backend.flexpay.cd/api/rest/v1/check

# SMS OTP (Keccel — RDC)
KECCEL_SMS_TOKEN=
KECCEL_SMS_FROM=LIALALIONNE
KECCEL_SMS_GATEWAY=https://api.keccel.com/sms/v2/message.asp

# Meta Pixel (Facebook/Instagram Ads) — trouvable dans Meta Events Manager.
# Laissé vide = pixel désactivé. Ne se charge que si le visiteur accepte les
# cookies de mesure d'audience (bandeau RGPD).
META_PIXEL_ID=

# Bot WhatsApp (API /api/bot/* et lien /payer/{token}) — voir docs/BOT_WHATSAPP.md
# Clé partagée avec la plateforme WhatsApp (en-tête X-Bot-Key). Vide = API désactivée.
BOT_API_KEY=
# Remise (%) quand une routine complète est commandée. 0 = désactivée.
BOT_KIT_DISCOUNT_PERCENT=0
BOT_PAYMENT_LINK_TTL_HOURS=72
# Webhook de la plateforme prévenu à chaque changement de statut d'une commande WhatsApp.
BOT_NOTIFY_URL=
BOT_NOTIFY_SECRET=
BOT_COUNTRY=CD

# Callbell (envoi des messages WhatsApp de suivi de commande), comme pour Rachoux.
CALLBELL_API_TOKEN=
CALLBELL_CHANNEL_UUID=
CALLBELL_TEAM_UUID=

# Conseillère IA (Claude) — endpoint POST /api/bot/v1/dialogue.
# Sans clé, chaque message WhatsApp est transféré à l'équipe.
ANTHROPIC_API_KEY=
BOT_AI_MODEL=claude-haiku-4-5-20251001
BOT_AI_MAX_TOKENS=1024
BOT_AI_SESSION_TTL_HOURS=12
BOT_AI_ASYNC=true
BOT_AI_REPLY_CHANNEL=poll
